#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>
#include <locale/keys_de.h>

#define BASE 0
#define FIRST 1
#define SECOND 2
#define NUMS 3

/ {
  behaviors {
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap";
            quick-tap-ms = <175>;
        };
        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            bindings = <&kp>, <&kp>;
            display-name = "Mod-Tap";
            quick-tap-ms = <175>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";
// ------------------------------------------------------------------------------------------------------------
// |  Q  |  W  |  E   |  R   |  T   |                        |  Y   |  U    |  I    |  O   |   P   |
// |  A  |  S  |  D   |  F   |  G   |                        |  H   |  J    |  K    |  L   |   Ö   |
// |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  | PLAY/PAUSE |  N   |  M    |  ,    |  .   |   -   |
// | ESC | GUI | ALT  | TAB  | SPACE|  CTRL  |  | BSPACE     | RET  | CTRL  | ALT   |  ß   | ENTF  |
             bindings = <
&kp Q        &kp W        &kp E        &kp R     &kp T                                &kp DE_Z  &kp U        &kp I        &kp O        &kp P
&lt FIRST A  &lt NUMS S   &mt LSHFT D  &kp F     &kp G                                &kp H     &kp J        &mt RSHFT K  &lt SECOND L &lt FIRST DE_O_UMLAUT 
&kp DE_Y     &kp DE_X     &kp C        &kp V     &kp B      &kp C_MUTE     &kp C_PP   &kp N     &kp M        &kp COMMA    &kp DOT      &kp DE_MINUS
&kp ESC      &kp TAB      &kp LGUI     &kp LALT  &kp SPACE  &kp LCTRL      &kp BSPC   &kp RET   &mo SECOND   &kp RALT     &kp DE_SZ    &kp DEL
 // encoder push buttons (left, right)
&kp C_MUTE  &kp C_MUTE
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        first_layer {
            display-name = "first layer";
// ------------------------------------------------------------------------------------------------------------
// |  @  |  "  |  €   |  ~   |  '      |                   |  |   |  ü    |  x    |  ö   |   x   |
// |  ä  |  !  |  #   |  $   |  %      |                   |  /   |  (    |  [    |  {   |   <   |
// |  =  |  -  |  +   |  *   |  &      |   ´    |  |       |  \   |  )    |  ]    |  }   |   >   |
//       |     |      |      |         |        |  |       |      |       |       |      |
            bindings = <
&kp DE_AT        &kp DE_DQT     &kp DE_EURO   &kp DE_TILDE &kp DE_SQT                             &kp DE_PIPE   &kp DE_U_UMLAUT  &trans       &kp DE_O_UMLAUT &trans
&kp DE_A_UMLAUT  &kp DE_EXCL    &kp DE_HASH   &kp DE_DLLR  &kp DE_PRCNT                           &kp DE_SLASH  &kp DE_LPAR      &kp DE_LBKT  &kp DE_LBRC     &kp DE_LT
&kp DE_EQUAL     &kp DE_MINUS   &kp DE_PLUS   &kp DE_STAR  &kp DE_AMPS   &kp DE_GRAVE   &trans    &kp DE_BSLH   &kp DE_RPAR      &kp DE_RBKT  &kp DE_RBRC     &kp DE_GT
&trans           &trans         &trans        &trans       &trans        &trans         &trans    &trans        &trans           &trans       &trans          &trans
// encoder push buttons (left, right)
&trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        second_layer {
            display-name = "second layer";
// ------------------------------------------------------------------------------------------------------------
// |AUDIOUP| PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |
// |AUDIODW| CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  |
// |       | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |
//                |       |       |      |      |  |      |      |      |       |      |       |
            bindings = <
&kp C_VOL_UP  &kp PSCRN    &kp K_CMENU  &trans       &trans                        &kp PG_UP &trans    &kp UP   &trans    &trans 
&kp C_VOL_DN  &kp LCTRL    &kp LSHFT    &trans       &kp CLCK                      &kp PG_DN &kp LEFT  &kp DOWN &kp RIGHT &kp DEL
&trans        &kp K_CUT    &kp K_COPY   &kp K_PASTE  &trans     &trans    &trans   &trans    &trans    &trans   &trans    &trans 
&trans        &trans       &trans       &trans       &trans     &trans    &trans   &trans    &trans    &trans    &trans    &trans
// encoder push buttons (left, right)
&trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        num_layer {
            display-name = "num layer";
// ------------------------------------------------------------------------------------------------------------
// |      |      |       |       |      |                | PGUP |   7  |   8   |  9   |       |
// |      |      |       |       |      |                | PGDN |   4  |   5   |  6   |       |
// |      |      |       |       |      |      |  |      |      |   1  |   2   |  3   |       |
// |      |      |       |       |      |      |  |      |      |   0  |       |      |       |
            bindings = <
&trans   &trans  &trans  &trans  &trans                    &kp PG_UP &kp DE_N7       &kp DE_N8       &kp DE_N9       &trans
&trans   &trans  &trans  &trans  &trans                    &kp PG_DN &kp DE_N4       &kp DE_N5       &kp DE_N6       &trans
&trans   &trans  &trans  &trans  &trans  &trans    &trans  &trans    &kp DE_N1       &kp DE_N2       &kp DE_N3       &trans
&trans   &trans  &trans  &trans  &trans  &trans    &trans  &trans    &kp DE_N0       &trans          &trans          &trans 
// encoder push buttons (left, right)
&trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};

